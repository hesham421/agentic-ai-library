<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>io.agenticai</groupId>
    <artifactId>agentic-ai-library</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Agentic AI Library</name>
    <description>Reusable, domain-agnostic Agentic AI library built on Spring AI</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Spring AI 2.0.1 is built and tested against Spring Boot 4.1.1 (see README "Compatibility") -->
        <spring-ai.version>2.0.1</spring-ai.version>
        <!-- DOC document readers (PORTS-DOCUMENT): neither library is managed by the Boot BOM -->
        <pdfbox.version>3.0.8</pdfbox.version>
        <poi.version>5.5.1</poi.version>
        <!-- springdoc 3.1.x is the line built on Spring Boot 4.1 / Framework 7 (3.1.1's parent is Boot 4.1.0;
             2.8.x/2.9.x target Boot 3.x). API document only, no UI: read by the api-doc generator. -->
        <springdoc.version>3.1.1</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Version alignment only: no Spring AI module is on the classpath during bootstrap -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- The running app's OpenAPI document (/v3/api-docs, one GroupedOpenApi group per module —
             io.agenticai.platform.config.OpenApiGroupsConfiguration), read by
             governance/governance-tools/api-doc-generator to publish each module's api-docs. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <!-- Oracle 19c is the dialect of every module's db-script; the schema is environment-provided -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Non-Unicode database character sets (the TEST database is AR8MSWIN1256): without it the thin
             driver refuses logon with ORA-17056. Version from the Boot-managed ojdbc BOM. -->
        <dependency>
            <groupId>com.oracle.database.nls</groupId>
            <artifactId>orai18n</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Schema migrations: each module's db-script sql fence, applied verbatim from
             src/main/resources/db/migration (V1 REG, V2 DOC, V3 CHK, V4 RPT). Versions from the Boot parent. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
<!--        <dependency>-->
<!--            <groupId>org.flywaydb</groupId>-->
<!--            <artifactId>flyway-database-oracle</artifactId>-->
<!--        </dependency>-->
        <!-- DOC PORTS-DOCUMENT readers: PDF text extraction (PdfTextReader, REQ-DOC-025) and
             spreadsheet table extraction, HSSF (.xls) + XSSF (.xlsx) (SpreadsheetTableReader, REQ-DOC-026) -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
            <exclusions>
                <!-- Spring's spring-jcl already provides the commons-logging API; two copies on
                     the classpath would shadow each other -->
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <!-- DOC PORTS-MODEL: the document-reading model (DocumentReadingModelPort, REQ-DOC-027/030/032).
             v1 supports ONE provider through Spring AI's OpenAI-compatible API — local and free-tier
             gateways are reached by base URL; the go-live provider is decided later (domain-profile D3).
             The only provider-bound code is the single ChatModel bean in doc.config; every other class
             sees the provider-neutral ChatModel / Prompt / Media API (G12). Version from spring-ai-bom. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <!-- Platform MCP query channel (io.agenticai.platform.mcp.SpringAiMcpQueryChannel, PORTS-QUERY): the Spring AI
             MCP CLIENT calling a connection's query tool behind the DOC/CHK query ports. Never a model tool (G1): the
             MCP→ToolCallback bridge is switched off (spring.ai.mcp.client.toolcallback.enabled=false in
             application.properties). Version from spring-ai-bom. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-baseline</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                    <message>This project requires Java 25+. Point JAVA_HOME at a JDK 25.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
